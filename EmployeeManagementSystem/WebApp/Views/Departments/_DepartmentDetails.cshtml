@model Department


<form method="post" 
      asp-controller="Departments"
      asp-action="@ViewBag.Action" >

    @if (ViewBag.Action == "edit")
    {
        <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
            <input type="hidden" name="Id" value="@Model.Id"/> -->
        <input asp-for="Id"/>
    }

    <div class="row mb-3">
        <div class="col-2">
            <!-- This line was changed to use the asp-for attribute.
                <label class="col-form-label">Name</label> -->
            <label class="col-form-label" asp-for="Name"></label>
        </div>
        <div class="col-6">
            <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
                <input type="text" name="Name" value="@Model.Name" class="form-control"/> -->
            <input class="form-control" asp-for="Name" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-2">
            <!-- This line was changed to use the asp-for attribute.
                <label class="col-form-label">Description</label> -->
            <label class="col-form-label" asp-for="Description"></label>
        </div>
        <div class="col-6">
            <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
                <input type="text" name="Description" value="@Model.Description" class="form-control"/> -->
            <input class="form-control" asp-for="Description">
        </div>
    </div>
    
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label" asp-for="Email"></label>
        </div>
        <div class="col-6">
            <input class="form-control" asp-for="Email" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-1">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
        <div class="col-1">
            <!-- This line was replaced to use asp.net tag helpers instead to auto-generate the link address
                <a class="btn btn-secondary" href="/departments">Cancel</a> -->
            <a class="btn btn-primary"
               asp-controller="Departments"
               asp-action="Index">Cancel</a>
        </div>
        <div class="col-4">
            @if (ViewBag.Action == "edit")
            {
                <!-- This line was replaced to use asp.net tag helpers instead to auto-generate the link address
                    <a href="/employees/departmentemployees/@Model.Id" class ="btn btn-link">Check Employees</a> -->
                <a class="btn btn-link"
                   asp-page="/employees/departmentemployees"
                   asp-route-departmentId="@Model.Id">Check Employees</a>
            }
        </div>

    </div>
</form>

<br>
