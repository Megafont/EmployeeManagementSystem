
@model Department

@{
    // Store the page title in the view bag so the layout file can set it as the page title.
    ViewBag.Title = "Department Details";
    ViewBag.Action = "edit";
}


@section title_section
{
    <h3>Department Details</h3>
}


@await Html.PartialAsync("_DepartmentDetails", @Model)

<form name="deleteDepartmentForm"
      method="post"
      asp-controller="Departments"
      asp-action="Delete"
      asp-route-Id="@Model.Id">

    <button type="submit" id="delete-department" class="btn btn-danger">Delete</button>

</form>


@section scripts
{
    <script>
        document.querySelector("#delete-department").addEventListener("click", (event) => {
            event.preventDefault(); // Prevents the default form submission from happening. We will trigger it below once the user confirms the delete action.

            const departmentName = '@Model.Name';

            const userConfirmation = confirm(`Are you sure you want to delete department '${departmentName}'?`);
            if (userConfirmation)
                document.forms["deleteDepartmentForm"].submit();

        });
    </script>
}