@model Department


@if (Model is not null)
{
    <tr>
        <td>@Model.Name</td>
        <td>@Model.Description</td>
        <td>@Model.Email</td>
        <td>
            <!-- This line was replaced to use asp.net tag helpers instead to auto-generate the link address
                <a class="btn btn-secondary" href="/departments/details/@Model.Id">Edit</a> -->
            
            <!--This link was changed to show as a button, hence why it is commented out now.
                <a class="btn btn-link"
                   asp-controller="Departments"
                   asp-action="Details"
                   asp-route-id="@Model.Id">Edit</a> -->

            <a class="btn btn-primary"
               asp-controller="Departments"
               asp-action="Details"
               asp-route-id="@Model.Id">Edit</a>

            <!-- You can add asp-route- and put anything after it. If the specified action does not have a parameter with that name, it will add one
                 in the query string of the URL. You can have multiple asp-route- tag helpers here.-->
        </td>
        <td>
            <form method="post" asp-controller="Departments" asp-action="Delete" asp-route-id="@Model.Id">
                <button type="submit" class="btn btn-danger delete-department-btn" data-department-name="@Model.Name">Delete</button>
            </form>
        </td>
    </tr>
}