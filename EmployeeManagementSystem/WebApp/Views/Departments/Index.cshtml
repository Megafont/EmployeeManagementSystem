
@{
    // Store the page title in the view bag so the layout file can set it as the page title.
    ViewBag.Title = "Departments";
}


@section title_section
{
    <h3>Departments</h3>
}


@await Html.PartialAsync("_SearchBar")

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Email</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody id="department-list">

    </tbody>
</table>

<br>

<!-- This line was replaced to use asp.net tag helpers instead to auto-generate the link address
    <a class="btn btn-primary" href="/departments/create">Add Department</a> -->
<a class="btn btn-primary"
   asp-controller="Departments"
   asp-action="Create">Add</a>

<!--We moved this script into a scripts section so that the layout file can ensure this script always appears at the bottom of the page so all
    page elements will be loaded in before it runs this script.
-->
@section scripts
{
     <script>
        // Loads the departments list when the page first loads.
        loadDepartments('');

        // Updates the departments list when the search button is clicked.
        document.querySelector("#search-button").addEventListener("click", async () =>
        {
            var filter = document.querySelector("#search-filter").value;

            loadDepartments(filter);
        });

        // Fetches the departments list from the endpoint.
        async function loadDepartments(filter)
        {
            var response = await fetch(`/department-list/${filter}`);
            var departmentsHTML = await response.text();

            document.querySelector("#department-list").innerHTML = departmentsHTML;
        }

        // Uses event delegation on the table body so that delete confirmation
        // works on dynamically loaded rows. Since the rows are injected via
        // innerHTML (which strips <script> tags), we can't attach listeners
        // inside the partial — we attach them here on the parent container.
        document.querySelector("#department-list").addEventListener("click", (event) => {
            const btn = event.target.closest(".delete-department-btn");
            if (!btn) return;

            event.preventDefault(); // Prevents the default form submission. We will trigger it below once the user confirms the delete action.

            const departmentName = btn.dataset.departmentName;

            const userConfirmation = confirm(`Are you sure you want to delete department '${departmentName}'?`);
            if (userConfirmation)
                btn.closest("form").submit();
        });
    </script>

}