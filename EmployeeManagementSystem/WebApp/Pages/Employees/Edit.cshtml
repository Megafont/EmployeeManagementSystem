@page "{id:int}"
@model WebApp.Pages.Employees.EditModel
@{
    ViewBag.Action = "edit";
}

@section title_section
{
    <h3>Edit Employee</h3>
}


@await Html.PartialAsync("_EmployeeDetails", Model.EmployeeViewModel)

<form 
    name="deleteEmployeeForm"
    method="post"
    asp-page="/employees/edit"
    asp-route-id="@Model.EmployeeViewModel.Employee.Id"
    asp-page-handler="DeleteEmployee" >

    <!--This adds an anti-forgery token that ensures a post from this form actually came from us and not a hacker somewhere.
        @Html.AntiForgeryToken()
    
        This is now commented out, because the asp-page tag helper we just added above does this for us as well.
    -->

    <button type="submit" id="delete-employee" class="btn btn-danger">Delete</button>

</form>


@section scripts
{
    <script>
        document.querySelector("#delete-employee").addEventListener("click", (event) => {
            event.preventDefault(); // Prevents the default form submission from happening. We will trigger it below once the user confirms the delete action.

            const employeeName = '@Model.EmployeeViewModel.Employee.Name';

            const userConfirmation = confirm(`Are you sure you want to delete employee '${employeeName}'?`);
            if (userConfirmation)
                document.forms["deleteEmployeeForm"].submit();

        });
    </script>
}
