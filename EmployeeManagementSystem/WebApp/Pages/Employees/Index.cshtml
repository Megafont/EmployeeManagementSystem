@page
@model WebApp.Pages.Employees.IndexModel

@section title_section
{
    <h3>Employees</h3>    
}

@await Html.PartialAsync("_SearchBar")

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Position</th>
        <th>Salary</th>
        <th>Department</th>
        <th></th>
    </tr>
    </thead>
    <tbody id="employee-list">
        @if (Model.Employees != null && Model.Employees.Count > 0)
        {
            foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.Name</td>
                    <td>@employee.Position</td>
                    <td>@employee.Salary</td>
                    <td><a class="btn btn-link" href="/departments/details/@employee.DepartmentId">@employee.Department?.Name</a></td>
                    <td><a class="btn btn-link" href="/employees/edit/@employee.Id">Edit</a></td>
                </tr>
            }
        }
    </tbody>
</table>

<br>
<a class="btn btn-primary" href="/employees/create">Add Employee</a>

