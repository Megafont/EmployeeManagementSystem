@page
@model WebApp.Pages.Employees.IndexModel

@section title_section
{
    <h3>Employees</h3>    
}

@await Html.PartialAsync("_SearchBar")

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Position</th>
        <th>Salary</th>
        <th>Department</th>
        <th>Email</th>
        <th></th>
        <th></th>
    </tr>
    </thead>
    <tbody id="employee-list">
        <!--This is commented out since it is no longer in use. The list is filled in by the javascript below instead.-->
        @* @await Component.InvokeAsync("EmployeeList") *@
    </tbody>
</table>

<br>
<!-- This line was replaced to use asp.net tag helpers instead to auto-generate the link address
    <a class="btn btn-primary" href="/employees/create">Add Employee</a> -->
<a class="btn btn-primary"
   asp-page="/employees/create">Add</a>

<!--We moved this script into a scripts section so that the layout file can ensure this script always appears at the bottom of the page so all
page elements will be loaded in before it runs this script.
-->
@section scripts
{
    <script>
        // Loads the employee list when the page first loads.
        loadEmployees('');
        
        // Updates the departments list when the search button is clicked.
        document.querySelector("#search-button").addEventListener("click", async () => 
        {
            var filter = document.querySelector("#search-filter").value;

            loadEmployees(filter);
        });

        // Fetches the departments list from the endpoint.
        async function loadEmployees(filter) {
            var response = await fetch(`/employees?filter=${filter}&handler=SearchEmployeesResult`);
            var employeesHTML = await response.text();

            document.querySelector("#employee-list").innerHTML = employeesHTML;
        }

        // Uses event delegation on the table body so that delete confirmation
        // works on dynamically loaded rows. Since the rows are injected via
        // innerHTML (which strips <script> tags), we can't attach listeners
        // inside the partial, so we attach them here on the parent container.
        document.querySelector("#employee-list").addEventListener("click", (event) => {
            const btn = event.target.closest(".delete-employee-btn");
            if (!btn) return;

            event.preventDefault(); // Prevents the default form submission. We will trigger it below once the user confirms the delete action.

            const employeeName = btn.dataset.employeeName;

            const userConfirmation = confirm(`Are you sure you want to delete employee '${employeeName}'?`);
            if (userConfirmation)
                btn.closest("form").submit();
        });
    </script>

}