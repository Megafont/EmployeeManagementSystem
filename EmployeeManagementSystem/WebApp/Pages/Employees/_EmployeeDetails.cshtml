
@using Microsoft.AspNetCore.Mvc.Formatters
@model EmployeeViewModel

@if (Model != null && Model.Employee != null)
{
    <!--We don't have to pass the action (edit or create) back to the caller in this form, since we're using Razor Pages for the employees
        side of the app. The form just gets submitted back to the same razor page that called it via the corresponding post handler in
        that page's code behind.
        
        NOTE: We are not using tag helpers like asp-controller in this form tag, since this form posts back to itself when submitted.
              As such, we don't need to use any tag helpers.
    -->
    <form method="post">
        <!--This adds an anti-forgery token that ensures a post from this form actually came from us and not a hacker somewhere.-->
        @Html.AntiForgeryToken()
        

        <!--NOTE: Unlike the asp-validation-for tag helpers used above, the asp-validation-summary will not display until the user submits the form.
        this is its default behavior.-->
        <div asp-validation-summary="All" class="text-danger"></div>


        <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
            <input type="hidden" name="Employee.Id" value="@Model.Employee.Id" /> -->
        <input type="hidden" asp-for="Employee.Id" />

        <div class="row mb-3">
            <div class="col-2">
                <!-- This line was changed to use the asp-for attribute.
                    <label class="col=form-label">Name</label> -->
                <label class="col=form-label" asp-for="Employee.Name"></label>
            </div>
            <div class="col-6">
                <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
                    <input type="text" name="Employee.Name" value="@Model.Employee.Name" class="form-control"/> -->
                <input class="form-control" asp-for="Employee.Name"/> 
                <!--This span displays a validation message if this field does not contain a valid value. This client-side validation won't work without the three jquery script tags we added at the bottom of Views/Shared/_Layout.cshtml-->
                <span class="text-danger" asp-validation-for="Employee.Name"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-2">
                <!-- This line was changed to use the asp-for attribute.
                    <label class="col=form-label">Position</label> -->
                <label class="col=form-label" asp-for="Employee.Position"></label>
            </div>
            <div class="col-6">
                <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
                    <input type="text" name="Employee.Position" value="@Model.Employee.Position" class="form-control"/> -->
                <input class="form-control" asp-for="Employee.Position"/>
                <!--This span displays a validation message if this field does not contain a valid value. This client-side validation won't work without the three jquery script tags we added at the bottom of Views/Shared/_Layout.cshtml-->
                <span class="text-danger" asp-validation-for="Employee.Position"></span>

            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-2">
                <!-- This line was changed to use the asp-for attribute.
                    <label class="col=form-label">Salary</label> -->
                <label class="col=form-label" asp-for="Employee.Salary"></label>
            </div>
            <div class="col-6">
                <!-- This line was changed to replace the type, name, and value attributes with a single asp-for attribute.
                    <input type="number" name="Employee.Salary" value="@Model.Employee.Salary" class="form-control"/> -->
                <input class="form-control" asp-for="Employee.Salary"/>
                <!--This span displays a validation message if this field does not contain a valid value. This client-side validation won't work without the three jquery script tags we added at the bottom of Views/Shared/_Layout.cshtml-->
                <span class="text-danger" asp-validation-for="Employee.Salary"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-2">
                <!-- This line was changed to use the asp-for attribute.
                <label class="col=form-label">Department</label> -->
                <label class="col=form-label" asp-for="Employee.DepartmentId"></label>
            </div>
            <div class="col-6">
    
                <!-- This line was changed to use the asp-for attribute.
                <select name="Employee.DepartmentId" class="form-control"> -->
                <select class="form-control"
                        asp-for="Employee.DepartmentId"
                        asp-items='Model.Departments.Select(x => new SelectListItem() { Text = x.Name, Value = x.Id.ToString(), Selected = (ViewBag.Action == "edit" && x.Id == Model.Employee.DepartmentId) })'>
                    
                    <!--The options added by the add-items tag helper above will be added after this code runs so this item will be the first in the list.-->
                    @if (ViewBag.Action == "create")
                    {
                        <option selected value="0">-- Please Select --</option>
                    }
                    else
                    {
                        <option value="0">-- Please Select --</option>
                    }

                </select>
                <!--This span displays a validation message if this field does not contain a valid value. This client-side validation won't work without the three jquery script tags we added at the bottom of Views/Shared/_Layout.cshtml-->
                <span class="text-danger" asp-validation-for="Employee.DepartmentId"></span>
 
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-2">
                <label class="col-form-label" asp-for="Employee.Email"></label>
            </div>
            <div class="col-6">
                <input class="form-control" asp-for="Employee.Email" />
                <!--This span displays a validation message if this field does not contain a valid value. This client-side validation won't work without the three jquery script tags we added at the bottom of Views/Shared/_Layout.cshtml-->
                <span class="text-danger" asp-validation-for="Employee.Email"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-1">
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
            <div class="col-1">
                <!-- This line was replaced to use asp.net tag helpers instead to auto-generate the link address
                    <a class="btn btn-secondary" href="/employees">Cancel</a> -->
                <a class="btn btn-primary" 
                   asp-page="/employees/index">Cancel</a>
            </div>
            <div class="col-4">

            </div>

        </div>
    </form>
}